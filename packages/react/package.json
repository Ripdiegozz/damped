{
  "name": "@damped/react",
  "version": "0.1.0",
  "license": "MIT",
  "description": "React hooks and components for damped spring animations, without per-frame re-renders.",
  "keywords": ["spring", "animation", "physics", "interruptible", "velocity", "react", "hooks"],
  "homepage": "https://damped.dagadev.net/reference/react/",
  "bugs": { "url": "https://github.com/Ripdiegozz/damped/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/Ripdiegozz/damped.git", "directory": "packages/react" },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "rm -rf dist && bun build.ts && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@damped/core": ">=0.1.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@damped/core": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
