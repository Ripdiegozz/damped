{
  "name": "@damped/native",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Velocity-preserving spring animations for Expo and React Native Reanimated.",
  "keywords": ["spring", "animation", "physics", "interruptible", "velocity", "react-native", "reanimated", "expo"],
  "homepage": "https://damped.dagadev.net/reference/native/",
  "bugs": { "url": "https://github.com/Ripdiegozz/damped/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/Ripdiegozz/damped.git", "directory": "packages/native" },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "rm -rf dist && bun build.ts && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react-native-reanimated": ">=4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@types/babel__core": "^7.20.5",
    "@damped/core": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}
