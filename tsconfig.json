{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@damped/core": ["./packages/core/src/index.ts"],
      "@damped/react": ["./packages/react/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "apps/docs/src",
    "apps/docs/scripts",
    "apps/docs/test",
    "test",
    "e2e",
    "playwright.config.ts"
  ],
  "exclude": ["apps/docs/src/content.config.ts"]
}
