---
// One package on the landing page: its name, what it is for, the install command and a snippet (the slot, written
// as fenced code in the MDX so the docs example harness typechecks it), and a link to its reference page.
interface Props {
  name: string;
  purpose: string;
  href: string;
  /** Platform line under the name, for example "Web". */
  platform: string;
}

const { name, purpose, href, platform } = Astro.props;
---

<article class="package-card">
  <div class="package-card__about">
    <header class="package-card__head">
      <p class="package-card__platform">{platform}</p>
      <h3 class="package-card__name"><code>{name}</code></h3>
      <p class="package-card__purpose">{purpose}</p>
    </header>
    <a class="package-card__link" {href}>
      Reference <span aria-hidden="true">&rarr;</span><span class="visually-hidden"> for {name}</span>
    </a>
  </div>
  <div class="package-card__code"><slot /></div>
</article>
