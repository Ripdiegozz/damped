---
// Replaces Starlight's Hero on pages with `hero` frontmatter (only the landing page has one). Same data and the same
// `_top` page-title anchor; the difference is the live spring instrument under the copy, and plain links instead of
// Starlight's LinkButton: two neutral buttons (`primary`, `secondary`) and a quiet text link for anything `minimal`.
import { SpringInstrument } from "./SpringInstrument";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
---

<div class="hero landing-hero">
  <div class="landing-hero__copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="landing-hero__tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="landing-hero__actions">
          {actions.map(({ link: href, text, variant }) =>
            variant === "minimal" ? (
              <a class="landing-quiet" {href}>
                {text}
              </a>
            ) : (
              <a class:list={["landing-button", { "landing-button--solid": variant === "primary" }]} {href}>
                {text}
              </a>
            ),
          )}
        </div>
      )
    }
  </div>
  <div class="landing-hero__instrument">
    <SpringInstrument client:load />
  </div>
</div>
