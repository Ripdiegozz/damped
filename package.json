{
  "name": "damped-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "playwright test",
    "build": "bun run --filter './packages/*' build",
    "docs:build": "bun run --filter @damped/docs build",
    "docs:dev": "bun run --filter @damped/docs dev"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
