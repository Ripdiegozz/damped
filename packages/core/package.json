{
  "name": "@damped/core",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Interruptible, physically based spring animations for the web.",
  "keywords": ["spring", "animation", "physics", "interruptible", "velocity", "flip", "layout"],
  "homepage": "https://damped.dagadev.net/reference/core/",
  "bugs": { "url": "https://github.com/Ripdiegozz/damped/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/Ripdiegozz/damped.git", "directory": "packages/core" },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir dist --format esm --target browser --minify && tsc -p tsconfig.build.json"
  }
}
